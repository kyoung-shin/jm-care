generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PENDING
  ADMIN
  DIRECTOR
  INSTRUCTOR
  PARENT
  STUDENT
}

enum BranchStatus {
  ACTIVE
  PREPARING
  CLOSING
}

enum AdmissionSchoolStatus {
  VERIFIED
  REVIEW
  DRAFT
}

model Branch {
  id           String        @id @default(cuid())
  name         String
  region       String?
  status       BranchStatus  @default(ACTIVE)
  users        User[]
  students     Student[]
  pendingUsers PendingUser[]
}

model FranchiseStandard {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AdmissionSchool {
  id         String                @id @default(cuid())
  name       String
  dept       String?
  year       Int
  typesCount Int                   @default(0)
  status     AdmissionSchoolStatus @default(DRAFT)
  updatedBy  String?
  source     String?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  tracks     AdmissionTrack[]
}

model AdmissionTrack {
  id                String                @id @default(cuid())
  schoolId          String
  school            AdmissionSchool       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name              String
  period            String
  type              String?
  method            String?
  csatMinCriteria   String?
  koreanHistory     String?
  targetGrade       Float?
  targetCsatMinRate Int?
  targetRecordCount Int?
  status            AdmissionSchoolStatus @default(DRAFT)
  source            String?
  updatedBy         String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
}

model User {
  id               String          @id @default(cuid())
  username         String?         @unique
  passwordHash     String?
  name             String
  email            String?         @unique
  phone            String?
  role             Role            @default(PENDING)
  branchId         String?
  branch           Branch?         @relation(fields: [branchId], references: [id])
  students         Student[]       @relation("InstructorStudents")
  studentProfileId String?         @unique
  studentProfile   Student?        @relation("StudentLogin", fields: [studentProfileId], references: [id])
  children         Student[]       @relation("StudentParents")
  createdAt        DateTime        @default(now())
  pendingUser      PendingUser?
  scheduleEvents   ScheduleEvent[]
}

model ScheduleEvent {
  id           String   @id @default(cuid())
  instructorId String
  instructor   User     @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  date         String
  day          String
  time         String
  type         String
  label        String
  urgent       Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model PendingUser {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  email         String?
  phone         String?
  requestedRole String
  branchId      String?
  branch        Branch?   @relation(fields: [branchId], references: [id])
  reason        String?
  status        String    @default("PENDING")
  approvedAt    DateTime?
  approvedBy    String?
  createdAt     DateTime  @default(now())
}

model Student {
  id                  String                @id @default(cuid())
  name                String
  initial             String
  grade               String
  school              String
  enrolledMonths      Int                   @default(0)
  finalGoalSchool     String?
  finalGoalDetail     String?
  finalGoalTrack      String?
  midGoalSchool       String?
  midGoalDetail       String?
  midGoalTrack        String?
  daysUntilCSAT       Int?
  daysUntilHS         Int?
  overallReadiness    Int?
  peerAverage         Int?
  roadmap             Json?
  riskSignals         Json?
  subjectTargets      Json?
  instructorId        String
  instructor          User                  @relation("InstructorStudents", fields: [instructorId], references: [id])
  branchId            String
  branch              Branch                @relation(fields: [branchId], references: [id])
  mockExams           MockExam[]
  counselings         Counseling[]
  reports             Report[]
  goalHistories       GoalHistory[]
  statusUpdates       StudentStatusUpdate[]
  loginUser           User?                 @relation("StudentLogin")
  parents             User[]                @relation("StudentParents")
  appointmentRequests AppointmentRequest[]
  createdAt           DateTime              @default(now())
}

model StudentStatusUpdate {
  id               String   @id @default(cuid())
  studentId        String
  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  overallReadiness Int?
  peerAverage      Int?
  subjectTargets   Json?
  roadmap          Json?
  riskSignals      Json?
  note             String?
  createdBy        String?
  createdAt        DateTime @default(now())
}

model MockExam {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name       String
  date       String
  fullName   String?
  korean     Float?
  english    Float?
  math       Float?
  science    Float?
  avg        Float?
  percentile String?
  createdAt  DateTime @default(now())
}

model Counseling {
  id             String   @id @default(cuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date           String
  type           String
  topic          String
  summary        String
  internalMemo   String?
  parentShare    String?
  actionName     String?
  actionOwner    String?
  actionDeadline String?
  actionStatus   String   @default("in-progress")
  createdAt      DateTime @default(now())
}

model GoalHistory {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      String
  label     String
  target    String
  track     String
  reason    String?
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Report {
  id        String    @id @default(cuid())
  studentId String
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  period    String
  message   String?
  sentAt    DateTime?
  viewedAt  DateTime?
  createdAt DateTime  @default(now())
}

model AppointmentRequest {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type          String // "phone" | "in_person"
  slot1         String
  slot2         String
  slot3         String
  status        String   @default("pending") // pending | confirmed | declined
  confirmedSlot String?
  requestedBy   String?
  createdAt     DateTime @default(now())
}
